// ============================================================
// STRIPE DEPOSIT CHECKOUT
// ============================================================

app.post(
"/api/create-deposit-checkout",
async(req,res)=>{

try{


const {

name,
email,
phone,
address,
service,
price,
deposit,
remaining,
date,
timeSlot

}=req.body;



// CHECK SLOT

const existing =
db.prepare(`
SELECT id
FROM bookings
WHERE date = ?
AND timeSlot = ?
AND status != 'cancelled'
`).get(
date,
timeSlot
);



if(existing){

return res.status(400).json({

success:false,

message:
"Appointment time already booked"

});

}





// CREATE STRIPE SESSION

const session =
await stripe.checkout.sessions.create({

payment_method_types:[
"card"
],

mode:"payment",

customer_email:
email,


line_items:[

{

price_data:{

currency:"usd",

product_data:{

name:
`${service} Deposit`

},


unit_amount:
Math.round(
deposit * 100
)

},


quantity:1

}

],



success_url:
`${process.env.FRONTEND_URL}/success.html?session_id={CHECKOUT_SESSION_ID}`,



cancel_url:
`${process.env.FRONTEND_URL}/booking.html`


});





// SAVE BOOKING

const result =
db.prepare(`
INSERT INTO bookings
(
name,
email,
phone,
address,
service,
price,
deposit,
remaining,
date,
timeSlot,
paymentType,
stripeSession,
status
)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)
`).run(

name,
email,
phone,
address,
service,
price,
deposit,
remaining,
date,
timeSlot,
"Deposit Paid",
session.id,
"pending"

);





// SEND DATABASE ID TO SUCCESS PAGE

res.json({

success:true,

checkoutUrl:
session.url,

bookingId:
result.lastInsertRowid


});



}catch(error){


console.log(
"Stripe error:",
error.message
);


res.status(500).json({

success:false,

message:
"Stripe payment failed"

});


}


});



